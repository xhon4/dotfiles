// r4chi-dotfiles · by occhi
{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "custom/spotify",
        "custom/sep2",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "custom/sep",
        "custom/sep2",
        "tray",
        "custom/sep",
        "custom/clock"
    ],

    "custom/launcher": { "format": "=w=", "tooltip": false },
    "custom/sep":      { "format": " ",  "tooltip": false },
    "custom/sep2":     { "format": " | ","tooltip": false },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "sort-by-number": true,
        "all-outputs": false,
        "persistent-workspaces": { "*": 5 },
        "format-icons": {
            "1": "い",
            "2": "ろ",
            "3": "は",
            "4": "に",
            "5": "ほ",
            "6": "へ",
            "7": "と",
            "8": "ち",
            "9": "り",
            "default": "い"
        }
    },

    "hyprland/window": {
        "format": "󱂬  {}",
        "max-length": 35,
        "separate-outputs": true,
        "rewrite": { "": "Arch Linux" }
    },

    "custom/spotify": {
        "exec": "~/.config/waybar/scripts/spotify_status.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "playerctl --player=spotify play-pause",
        "on-click-middle": "playerctl --player=spotify previous",
        "on-click-right": "playerctl --player=spotify next",
        "on-scroll-up": "playerctl --player=spotify volume 0.05+",
        "on-scroll-down": "playerctl --player=spotify volume 0.05-",
        "tooltip": false
    },

    "cpu":    { "interval": 1, "format": "󰻠  {usage}% ", "tooltip": false },
    "memory": { "interval": 3, "format": "󰍛  {used:0.1f}G ", "tooltip": false },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟  Muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5,
        "format-icons": { "default": ["󰕿","󰕿","󰕿","󰖀","󰖀","󰖀","󰖀","󰖁","󰖁","󰕾"] },
        "tooltip": false
    },

    "network": {
        "format-ethernet": "󰛳",
        "format-disconnected": "󰈂  Disconnected",
        "format-wifi": "󰛳",
        "interval": 1,
        "tooltip": false
    },

    "tray": { "icon-size": 16, "spacing": 5 },

    "custom/clock": {
        "exec": "~/.config/waybar/scripts/clock_calendar.sh",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    }
}