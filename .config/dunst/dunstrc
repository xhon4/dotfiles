# r4chi-dotfiles · by occhi

# === GLOBAL ===
[global]
    monitor                  = 0
    follow                   = mouse
    width                    = 360
    height                   = (0, 140)
    origin                   = top-right
    offset                   = (12, 12)
    notification_limit       = 5

    progress_bar             = true
    progress_bar_height      = 8
    progress_bar_frame_width = 1

    separator_height         = 1
    padding                  = 12
    horizontal_padding       = 14

    font                     = JetBrainsMono Nerd Font 10
    markup                   = full
    format                   = "<b>%s</b>\n%b"
    alignment                = left

    frame_width              = 1
    frame_color              = "#F5582D"
    separator_color          = frame
    corner_radius            = 0

    icon_position            = left
    min_icon_size            = 32
    max_icon_size            = 64

    history_length           = 20
    dmenu                    = /usr/bin/rofi -dmenu -p dunst

    mouse_left_click         = close_current
    mouse_middle_click       = do_action, close_current
    mouse_right_click        = close_all

# === URGENCY ===
[urgency_low]
    background               = "#0A0708"
    foreground               = "#8E9EA1"
    frame_color              = "#4E6C92"
    timeout                  = 6

[urgency_normal]
    background               = "#0A0708"
    foreground               = "#cbe2e6"
    frame_color              = "#AA8C75"
    timeout                  = 8

[urgency_critical]
    background               = "#0A0708"
    foreground               = "#cbe2e6"
    frame_color              = "#F6592E"
    timeout                  = 0
